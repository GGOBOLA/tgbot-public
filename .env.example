# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SQLite file. Parent dirs are created on boot.
DB_PATH=./data/bot.db
# Comma-separated Telegram user IDs allowed to run /topup. Empty = nobody.
ADMIN_IDS=111111111,222222222
# HMAC key for signed button payloads. Required: at least 16 characters — the
# codec's enforced minimum (callback.MinSecret), which boot rejects below.
# 32 random hex bytes is the recommendation.
# Generate with: openssl rand -hex 32
CALLBACK_SECRET=
# Upstream OpenAI-compatible base URL. Validated at boot.
NINEROUTER_URL=http://127.0.0.1:20128
# Required for top-ups in production: your DuitNow QR image, kept on the host
# (it is git-ignored). Leave empty to boot without a QR. A path that is set but
# missing or unreadable stops boot; the file is not decoded, so a corrupt image
# only fails when Telegram is asked to send it. The deploy gate rejects a
# placeholder name or a path that is not a regular file.
PAYMENT_QR_PATH=
# Gateway. Empty = disabled. Needs the two vars below.
GATEWAY_ADDR=127.0.0.1:8787
# Internal 9router API key the gateway forwards with (never logged).
NINEROUTER_KEY=replace-with-your-9router-key
# Per-customer gateway rate limit: burst back-to-back, then sustained per second.
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=20
# Admin alerts: page when one hour of charges passes this RM amount, or when this
# many requests in ten minutes are rejected with 401/403 (a leaked or guessed
# key). Each fires at most once an hour.
SPEND_ALERT_MYR=100
AUTH_ALERT_BURST=50

# Brand image sent on a customer's first /start (optional; empty = disabled)
WELCOME_IMAGE_PATH=assets/welcome.png
