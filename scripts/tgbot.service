[Unit]
Description=tgbot - Telegram dashboard + OpenAI-compatible gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unprivileged service account: the gateway parses customer JSON, so a bug in it
# must not come with root. Files it needs are group-readable, data/ is its own.
User=tgbot
Group=tgbot
WorkingDirectory=/srv/tgbot
EnvironmentFile=/srv/tgbot/.env
ExecStart=/srv/tgbot/bin/tgbot
Restart=always
RestartSec=3

# Files the service creates are private to it, whatever the system umask says.
UMask=0077

# Sandbox: no privilege escalation, no host filesystem writes outside data/,
# no devices, no clock or kernel-module tampering, no namespaces, no new
# capabilities (the bot needs none: it speaks TCP to Telegram and 9router).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/tgbot/data

[Install]
WantedBy=multi-user.target
